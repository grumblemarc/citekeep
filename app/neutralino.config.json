{
  "applicationId": "app.citekeep",
  "version": "30.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "exportAuthInfo": false,
  "logging": { "enabled": false, "writeToLogFile": false },
  "nativeAllowList": ["app.*", "os.*", "filesystem.*", "storage.*", "window.*", "events.*", "computer.*"],
  "modes": {
    "window": {
      "title": "Citekeep",
      "width": 1280, "height": 860, "minWidth": 420, "minHeight": 500,
      "center": true, "resizable": true, "fullScreen": false, "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false, "borderless": false, "maximize": false, "hidden": false,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "Citekeep",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.4.0",
    "clientVersion": "5.4.0"
  }
}
